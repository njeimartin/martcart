# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key supported until the end of 2026:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server secret - never expose in client code
SUPABASE_SECRET_KEY=
# Legacy name supported for existing deployments:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server secrets - never expose in client code
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Production site URL
NEXT_PUBLIC_SITE_URL=https://your-martcart-domain.vercel.app
