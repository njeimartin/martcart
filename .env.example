# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alias supported by the app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase secret; never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server secrets must never be exposed to the browser)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Production site URL
NEXT_PUBLIC_SITE_URL=https://your-martcart-domain.vercel.app
